{
  "name": "changzheng-web-for-student",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "19341010",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
